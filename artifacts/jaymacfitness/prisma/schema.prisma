generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TRAINER
  CLIENT
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  PROSPECT
}

enum SessionType {
  GYM
  ONLINE
  OUTDOOR
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  LOST
}

enum PackageType {
  IN_PERSON
  ONLINE
  GROUP
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  role          Role           @default(CLIENT)
  createdAt     DateTime       @default(now())
  clientProfile ClientProfile?
  trainerSessions Session[]    @relation("TrainerSessions")
}

model ClientProfile {
  id               String       @id @default(cuid())
  userId           String       @unique
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName        String
  lastName         String
  phone            String?
  dob              DateTime?
  goals            String?
  medicalNotes     String?
  emergencyContact String?
  progressNote     String?
  joinedAt         DateTime     @default(now())
  status           ClientStatus @default(PROSPECT)
  sessions         Session[]
  bookings         Booking[]
}

model Session {
  id        String        @id @default(cuid())
  clientId  String
  client    ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  trainerId String
  trainer   User          @relation("TrainerSessions", fields: [trainerId], references: [id])
  date      DateTime
  duration  Int
  type      SessionType   @default(GYM)
  notes     String?
  cancelled Boolean       @default(false)
  completed Boolean       @default(false)
  slot      TrainerAvailability?
}

model TrainerAvailability {
  id         String      @id @default(cuid())
  date       DateTime
  duration   Int         @default(60)
  type       SessionType @default(GYM)
  isBooked   Boolean     @default(false)
  sessionId  String?     @unique
  session    Session?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())

  @@index([date])
}

model Package {
  id              String      @id @default(cuid())
  name            String      @unique
  type            PackageType @default(IN_PERSON)
  sessions        Int
  price           Decimal     @db.Decimal(10, 2)
  pricePerSession Decimal?    @db.Decimal(10, 2)
  description     String?
  highlights      String[]    @default([])
  isActive        Boolean     @default(true)
  featured        Boolean     @default(false)
  stripeLink      String?
  bookings        Booking[]
}

model Booking {
  id                String        @id @default(cuid())
  clientId          String
  client            ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  packageId         String
  package           Package       @relation(fields: [packageId], references: [id])
  purchasedAt       DateTime      @default(now())
  sessionsRemaining Int
}

model LeadEnquiry {
  id          String     @id @default(cuid())
  name        String
  email       String
  phone       String?
  message     String
  source      String?    @default("website")
  note        String?
  convertedClientId String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  status      LeadStatus @default(NEW)
}
